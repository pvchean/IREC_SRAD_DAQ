CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_pfs.csv"
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_TINYUSB_CDC_ENABLED=y
CONFIG_TINYUSB_MTP_ENABLED=y
CONFIG_TINYUSB_DESC_PRODUCT_STRING="IREC DAQ"
CONFIG_TINYUSB_DESC_CDC_STRING="IREC DAQ serial"
CONFIG_TINYUSB_DESC_MTP_STRING="IREC DAQ MTP"
CONFIG_TINYUSB_MTP_MAX_STORAGES=1
